  {
   "id": "ee-p-exp-1",
   "sides": [
    {
     "text": "A MOSFET has μCox = 100 µA/V², W/L = 20, and Vov = 0.2 V. What is I_D?",
     "options": [
      "4 µA",
      "40 µA",
      "400 µA",
      "80 µA"
     ]
    },
    {
     "text": "B. 40 µA",
     "more": {
      "text": "I_D = ½ × 100 µ × 20 × 0.04 = 40 µA."
     }
    }
   ]
  },
  {
   "id": "ee-p-exp-2",
   "sides": [
    {
     "text": "What is the kT/C noise on a 1 pF capacitor at 300 K?",
     "options": [
      "About 64 mV",
      "About 6.4 µV",
      "About 64 µV",
      "About 640 µV"
     ]
    },
    {
     "text": "C. About 64 µV",
